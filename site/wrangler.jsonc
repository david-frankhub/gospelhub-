{
  "name": "gospelhub",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "triggers": { "crons": ["0 6 */2 * *"] },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/song", "/song.html", "/song/*", "/video", "/video.html", "/video/*", "/news-post", "/news-post.html", "/news/*", "/sitemap.xml"]
  }
}
